{
  "permissions": {
    "allow": [
      "Bash(yarn test *)",
      "Bash(yarn test:e2e *)",
      "Bash(yarn lint *)",
      "Bash(yarn lint:fix *)",
      "Bash(yarn typecheck *)",
      "Bash(bun run test *)",
      "Bash(bun run test:e2e *)",
      "Bash(bun run lint *)",
      "Bash(bun run lint:fix *)",
      "Bash(bun run typecheck *)",
      "Bash(yarn tsc --noEmit *)",
      "Bash(bunx tsc --noEmit *)",
      "Bash(yarn vue-tsc --noEmit *)",
      "Bash(bunx vue-tsc --noEmit *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "Bash(pencil *)"
    ],
    "deny": [
      "Bash(git push *)"
    ]
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/notify.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/notify.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccline",
    "padding": 0
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "syntaxHighlightingDisabled": false,
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "auto",
  "skipAutoPermissionPrompt": true
}
