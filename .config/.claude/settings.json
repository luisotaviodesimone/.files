{
  "permissions": {
    "allow": [
      "Bash(yarn test *)",
      "Bash(yarn test:e2e *)",
      "Bash(yarn lint *)",
      "Bash(yarn lint:fix *)",
      "Bash(yarn typecheck *)",
      "Bash(bun run test *)",
      "Bash(bun run test:e2e *)",
      "Bash(bun run lint *)",
      "Bash(bun run lint:fix *)",
      "Bash(bun run typecheck *)",
      "Bash(yarn tsc --noEmit *)",
      "Bash(bunx tsc --noEmit *)",
      "Bash(yarn vue-tsc --noEmit *)",
      "Bash(bunx vue-tsc --noEmit *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh repo view *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git --no-pager diff *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(head *)",
      "Bash(echo *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "Bash(pencil *)",
      "Bash(xo-cli list-objects *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Read(./.env*.local)",
      "Read(./env.toml)",
      "Read(**/.env*.local)",
      "Read(**/env.toml)",
      "Read(**/.ssh/**)"
    ],
    "ask": [
      "Read(./.env)",
      "Read(**/.env)",
      "Bash(kubectl * patch *)",
      "Bash(kubectl * annotate *)",
      "Bash(kubectl * drain *)",
      "Bash(kubectl * exec *)",
      "Bash(kubectl * apply *)",
      "Bash(kubectl * delete *)",
      "Bash(psql *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(tofu * apply *)",
      "Bash(terraform * apply *)",
      "Bash(tf * apply *)",
      "Bash(aws *)",
      "Bash(mise exec *)"
    ]
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/notify.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/notify.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccline",
    "padding": 0
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "claude-mem@thedotmack": true,
    "ponytail@ponytail": true,
    "mattpocock-skills@mattpocock": true,
    "delta@zed-industries": false
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "zed-industries": {
      "source": {
        "source": "github",
        "repo": "zed-industries/delta-claude"
      }
    },
    "academic-research-skills": {
      "source": {
        "source": "github",
        "repo": "Imbad0202/academic-research-skills"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": true,
        "sendNames": true
      }
    }
  },
  "tui": "fullscreen",
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
