// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "disable_ai": false,
    "cli_default_open_behavior": "existing_window",
    "outline_panel": {
        "dock": "left"
    },
    "collaboration_panel": {
        "dock": "left"
    },
    "diff_view_style": "unified",
    "agent_servers": {
        "opencode": {
            "type": "registry"
        },
        "claude-acp": {
            "default_config_options": {
                "mode": "auto",
                "effort": "high",
                "model": "default"
            },
            "type": "registry",
            "env": {
                "CLAUDE_CODE_EXECUTABLE": "/home/luisotaviodesimone/.local/bin/claude"
            }
        }
    },
    "auto_update": false,
    "git_panel": {
        "dock": "left",
        "sort_by_path": true,
        "tree_view": true
    },
    "git": {
        "worktree_directory": ".git/worktrees"
    },
    "include_ignored": true,
    "project_panel": {
        "dock": "left",
        "hide_gitignore": false
    },
    "soft_wrap": "editor_width",
    "buffer_line_height": "comfortable",
    "edit_predictions": {
        "provider": "copilot",
        "ollama": {
            "api_url": "http://localhost:11434",
            "model": "qwen2.5-coder:7b",
            "prompt_format": "infer",
            "max_output_tokens": 512
        }
    },
    "ui_font_family": "JetBrainsMono Nerd Font Mono",
    "show_whitespaces": "trailing",
    "buffer_font_family": "JetBrainsMono Nerd Font Mono",
    "buffer_font_features": {
        "calt": true
    },
    "agent": {
        "notify_when_agent_waiting": "all_screens",
        "dock": "right",
        "tool_permissions": {
            "tools": {
                "create_directory": {
                    "always_allow": [
                        {
                            "pattern": "^ansible-playbooks-CI/playbooks/roles/netbird-peer/"
                        }
                    ]
                },
                "terminal": {
                    "always_allow": [
                        {
                            "pattern": "^uvx\\s+ansible-lint(\\s|$)"
                        }
                    ]
                }
            },
            "default": "confirm"
        },
        "default_profile": "write",
        "default_model": {
            "effort": "medium",
            "enable_thinking": true,
            "provider": "copilot_chat",
            "model": "gpt-5.2-codex"
        },
        "model_parameters": [],
        "play_sound_when_agent_done": "always",
        "expand_terminal_card": false,
        "inline_assistant_model": {
            "provider": "opencode",
            "model": "free/big-pickle"
        },
    },
    "symbols.files.associations": {
        "*.module.ts": "nest",
        "*.service.ts": "nest",
        "create-user.pipe.ts": "nest"
    },
    "material-icon-theme.activeIconPack": "nest",
    "icon_theme": "Material Icon Theme",
    "format_on_save": "off",
    "vim_mode": false,
    "file_scan_inclusions": [".env*", "docker-compose.*.yml"],
    "file_types": {
        "GitHub Actions": [
            ".github/workflows/*.yml",
            ".github/workflows/*.yaml"
        ],
        "Dockerfile": ["Dockerfile*"]
    },
    "wsl_connections": [
        {
            "distro_name": "Ubuntu-24.04",
            "user": null,
            "projects": []
        }
    ],
    "ui_font_size": 16,
    "buffer_font_size": 15,
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "One Dark Pro"
    },
    "lsp_document_colors": "background",
    "lsp": {
        "biome": {
            "settings": {
                "require_config_file": true
            }
        }
    },
    "languages": {
        "Vue.js": {
            "language_servers": [
                "typescript-language-server",
                "!vtsls",
                "!biome",
                "..."
            ]
        },
        "TypeScript": {
            // "formatter": { "language_server": { "name": "biome" } },
            "language_servers": [
                "typescript-language-server",
                "!vtsls",
                "!biome",
                "..."
            ]
        },
        "TSX": {
            // "formatter": { "language_server": { "name": "biome" } },
            "language_servers": [
                "typescript-language-server",
                "!vtsls",
                "!biome",
                "..."
            ]
        },
        "JavaScript": {
            // "formatter": { "language_server": { "name": "biome" } },
            "language_servers": [
                "typescript-language-server",
                "!vtsls",
                "!biome",
                "..."
            ]
        },
        "JSON": {
            // "formatter": { "language_server": { "name": "biome" } }
        }
    },
    "theme_overrides": {
        "One Dark Pro": {
            "syntax": {
                "constant.comment.todo": {
                    "color": "#000000",
                    "background_color": "#14adca",
                    "font_weight": 700
                },
                "constant.comment.todo.text": {
                    "color": "#14adca"
                },
                "constant.comment.todo.prefix": {
                    "color": "#14adca"
                },
                "string.comment.info": {
                    "color": "#50a14fff"
                },
                "keyword.comment.warn": {
                    "color": "#c18401ff"
                },
                "property.comment.error": {
                    "color": "#ca1243ff"
                }
            }
        }
    }
}
