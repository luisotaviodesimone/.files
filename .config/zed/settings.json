// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "debugger": {
        "timeout": 10000
    },
    "disable_ai": false,
    "context_servers": {
        "mcp-server-context7": {
            "enabled": true,
            "remote": false,
            "settings": {
                "context7_api_key": "ctx7sk-4b2342d1-8ea0-48ce-8161-62c7335d76e6"
            }
        }
    },
    "cli_default_open_behavior": "existing_window",
    "outline_panel": {
        "dock": "left"
    },
    "collaboration_panel": {
        "dock": "left"
    },
    // ---------- AI Stuff ----------
    "diff_view_style": "unified",
    "agent_servers": {
        "antigravity-acp": {
            "default_config_options": {
                "mode": "yolo",
                "model": "gemini-3.8-flash-high"
            },
            "type": "registry"
        },
        "opencode": {
            "type": "registry"
        },
        "claude-acp": {
            "default_config_options": {
                "mode": "auto",
                "effort": "high",
                "model": "opus"
            },
            "type": "registry",
            "env": {
                "CLAUDE_CODE_EXECUTABLE": "/home/luisotaviodesimone/.local/bin/claude"
            }
        }
    },
    "edit_predictions": {
        "open_ai_compatible_api": {
            "model": "opencode/deepseek-v4.1-flash-free",
            "api_url": "https://opencode.ai/inference/openai/v1/chat/completions"
        },
        "provider": "copilot"
    },
    "agent": {
        "inline_assistant_model": {
            "provider": "opencode",
            "model": "zen/deepseek-v4.1-flash-free",
            "enable_thinking": false
        },
        "default_model": {
            "enable_thinking": false,
            "provider": "opencode",
            "model": "opencode/deepseek-v4.1-flash-free"
        },
        "notify_when_agent_waiting": "all_screens",
        "dock": "right",
        "tool_permissions": {
            "tools": {
                "create_directory": {
                    "always_allow": [
                        {
                            "pattern": "^ansible-playbooks-CI/playbooks/roles/netbird-peer/"
                        }
                    ]
                },
                "terminal": {
                    "always_allow": [
                        {
                            "pattern": "^uvx\\s+ansible-lint(\\s|$)"
                        }
                    ]
                }
            },
            "default": "confirm"
        },
        "default_profile": "write",
        "model_parameters": [],
        "play_sound_when_agent_done": "always",
        "expand_terminal_card": false
    },
    "language_models": {
        "opencode": {
            "available_models": [
                {
                    "name": "deepseek-v4.1-flash-free",
                    "display_name": "DeepSeek V4.1 Flash Free",
                    "max_tokens": 1000000
                }
            ]
        }
    },
    // ------------------------------
    "auto_update": false,
    "git_panel": {
        "dock": "left",
        "sort_by_path": true,
        "tree_view": true
    },
    "git": {
        "worktree_directory": ".git/worktrees"
    },
    "include_ignored": true,
    "project_panel": {
        "dock": "left",
        "hide_gitignore": false
    },
    "soft_wrap": "editor_width",
    "buffer_line_height": "comfortable",
    "ui_font_family": "JetBrainsMono Nerd Font Mono",
    "show_whitespaces": "trailing",
    "buffer_font_family": "JetBrainsMono Nerd Font Mono",
    "buffer_font_features": {
        "calt": true
    },
    "symbols.files.associations": {
        "*.module.ts": "nest",
        "*.service.ts": "nest",
        "create-user.pipe.ts": "nest"
    },
    "material-icon-theme.activeIconPack": "nest",
    "icon_theme": "Material Icon Theme",
    "format_on_save": "off",
    "vim_mode": false,
    "file_scan_inclusions": [".env*", "docker-compose.*.yml"],
    "file_types": {
        "GitHub Actions": [
            ".github/workflows/*.yml",
            ".github/workflows/*.yaml"
        ],
        "Dockerfile": ["Dockerfile*"]
    },
    "wsl_connections": [
        {
            "distro_name": "Ubuntu-24.04",
            "user": null,
            "projects": []
        }
    ],
    "ui_font_size": 16,
    "buffer_font_size": 15,
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "One Dark Pro"
    },
    "lsp_document_colors": "background",
    "lsp": {
        // "oxfmt": {
        //     "initialization_options": {
        //         "settings": {
        //             "fmt.configPath": ".oxfmtrc.json"
        //         }
        //     }
        // }
    },
    "formatter": {
        "external": {
            "command": "bun",
            "arguments": [
                "fmt",
                "--no-script",
                "--stdin-filepath",
                "{buffer_path}"
            ]
        }
    },
    "languages": {
        "Vue.js": {
            "language_servers": ["typescript-language-server", "!vtsls", "..."],
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": [
                        "fmt",
                        "--no-script",
                        "--stdin-filepath",
                        "{buffer_path}"
                    ]
                }
            }
        },
        "TypeScript": {
            "language_servers": ["typescript-language-server", "!vtsls", "..."],
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": [
                        "fmt",
                        "--no-script",
                        "--stdin-filepath",
                        "{buffer_path}"
                    ]
                }
            }
        },
        "TSX": {
            "language_servers": ["typescript-language-server", "!vtsls", "..."],
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": [
                        "fmt",
                        "--no-script",
                        "--stdin-filepath",
                        "{buffer_path}"
                    ]
                }
            }
        },
        "JavaScript": {
            "language_servers": ["typescript-language-server", "!vtsls", "..."],
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": [
                        "fmt",
                        "--no-script",
                        "--stdin-filepath",
                        "{buffer_path}"
                    ]
                }
            }
        }
    },
    "theme_overrides": {
        "One Dark Pro": {
            "syntax": {
                "constant.comment.todo": {
                    "color": "#000000",
                    "background_color": "#14adca",
                    "font_weight": 700
                },
                "constant.comment.todo.text": {
                    "color": "#14adca"
                },
                "constant.comment.todo.prefix": {
                    "color": "#14adca"
                },
                "string.comment.info": {
                    "color": "#50a14fff"
                },
                "keyword.comment.warn": {
                    "color": "#c18401ff"
                },
                "property.comment.error": {
                    "color": "#ca1243ff"
                }
            }
        }
    }
}
