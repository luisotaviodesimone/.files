{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/gemma4",
  "provider": {
    "ollama": {
      "models": {
        "gemma4": {
          "_launch": true,
          "name": "gemma4",
          "tools": true
        },
        "gemma4:31b": {
          "_launch": true,
          "name": "gemma4:31b",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-4.7-flash": {
          "_launch": true,
          "name": "glm-4.7-flash"
        },
        "qwen3.5": {
          "_launch": true,
          "name": "qwen3.5"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  }
}

