{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "/home/luisotaviodesimone/.config/opencode/rules/*.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "kubectl logs *": "allow",
      "kubectl explain *": "allow",
      "helm list *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git status * ": "allow",
      "pencil * ": "allow",
      "head * ": "allow",
      "echo * ": "allow",
      "rg * ": "allow",
      "wc * ": "allow",
      "ls * ": "allow",
      "kubectl get secret": "ask"
    },
    "edit": "ask",
    "read": {
      "*secret*": "ask"
    }
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "figma": {
      "enabled": false,
      "oauth": {},
      "type": "remote",
      "url": "https://mcp.figma.com/mcp"
    },
    "pencil": {
      "command": [
        "/mnt/c/Program Files/Pencil/resources/app.asar.unpacked/out/mcp-server-windows-x64.exe",
        "--app",
        "desktop"
      ],
      "enabled": true,
      "type": "local"
    },
    "sequential-thinking": {
      "command": [
        "opencode",
        "x",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true,
      "type": "local"
    },
    "arxiv-mcp-server": {
      "type": "local",
      "command": [
        "uvx",
        "arxiv-mcp-server"
      ]
    },
    "zotero-mcp": {
      "type": "local",
      "command": [
        "zotero-mcp"
      ],
      "environment": {
        "ZOTERO_API_KEY": "{env:ZOTERO_API_KEY}",
        "ZOTERO_LIBRARY_ID": "21190845"
      }
    }
  },
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "gemma4": {
          "_launch": true,
          "name": "gemma4",
          "tools": true
        },
        "gemma4:31b": {
          "_launch": true,
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "name": "gemma4:31b"
        },
        "glm-4.7-flash": {
          "_launch": true,
          "name": "glm-4.7-flash"
        },
        "qwen2.5-coder:14b": {
          "_launch": true,
          "name": "qwen2.5-coder:14b"
        },
        "gemma4:e4b": {
          "_launch": true,
          "name": "gemma4:e4b",
          "options": {
            "num_ctx": 65536
          }
        },
        "ornith:9b": {
          "_launch": true,
          "name": "ornith:9b",
          "options": {
            "num_ctx": 65536
          }
        },
        "qwen3.5": {
          "_launch": true,
          "name": "qwen3.5",
          "options": {
            "num_ctx": 32000
          }
        }
      }
    },
    "llamacpp": {
      "name": "Llamacpp",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "NousResearch/Hermes-3-Llama-3.1-8B-GGUF:Q8_0": {
          "_launch": true,
          "name": "NousResearch/Hermes-3-Llama-3.1-8B-GGUF:Q8_0",
          "options": {
            "num_ctx": 32768
          }
        }
      }
    }
  }
}
