  "mcp": {
    "servers": {
      "context7": {
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "figma": {
        "oauth": {},
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
        "disabled": true
      },
      "pencil": {
        "command": [
          "/mnt/c/Program Files/Pencil/resources/app.asar.unpacked/out/mcp-server-windows-x64.exe",
          "--app",
          "desktop"
        ],
        "type": "local"
      },
      "sequential-thinking": {
        "command": [
          "opencode",
          "x",
          "@modelcontextprotocol/server-sequential-thinking"
        ],
        "type": "local"
      },
      "arxiv-mcp-server": {
        "type": "local",
        "command": ["uvx", "arxiv-mcp-server"]
      },
      "zotero-mcp": {
        "type": "local",
        "command": ["zotero-mcp"],
        "environment": {
          "ZOTERO_API_KEY": "{env:ZOTERO_API_KEY}",
          "ZOTERO_LIBRARY_ID": "21190845"
        }
      },
      "repomix": {
        "type": "local",
        "command": ["npx", "-y", "repomix", "--mcp"]
      },
      "rea": {
        "type": "local",
        "command": ["npx", "-y", "rea-agents@6.7.0", "mcp"]
      }
    }
  },
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "gemma4": {
          "_launch": true,
          "name": "gemma4",
          "tools": true
        },
        "gemma4:31b": {
          "_launch": true,
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "name": "gemma4:31b"
        },
        "glm-4.7-flash": {
          "_launch": true,
          "name": "glm-4.7-flash"
        },
        "qwen2.5-coder:14b": {
          "_launch": true,
          "name": "qwen2.5-coder:14b"
        },
        "gemma4:e4b": {
          "_launch": true,
          "name": "gemma4:e4b",
